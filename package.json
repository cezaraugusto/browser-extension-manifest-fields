{
  "name": "browser-extension-manifest-fields",
  "version": "2.2.6",
  "description": "Parse and resolve browser extension manifest fields to absolute paths.",
  "keywords": [
    "browser-extension",
    "webextension",
    "chrome-extension",
    "firefox",
    "edge",
    "manifest.json",
    "manifest v3",
    "mv3",
    "mv2",
    "web-accessible-resources",
    "content_scripts",
    "service_worker",
    "devtools",
    "icons",
    "webpack",
    "rspack",
    "bundler"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cezaraugusto/browser-extension-manifest-fields"
  },
  "homepage": "https://github.com/cezaraugusto/browser-extension-manifest-fields#readme",
  "bugs": {
    "url": "https://github.com/cezaraugusto/browser-extension-manifest-fields/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./manifest-fields": {
      "types": "./dist/manifest-fields/index.d.ts",
      "import": "./dist/manifest-fields/index.mjs",
      "require": "./dist/manifest-fields/index.js",
      "default": "./dist/manifest-fields/index.mjs"
    },
    "./special-folders": {
      "types": "./dist/special-folders/index.d.ts",
      "import": "./dist/special-folders/index.mjs",
      "require": "./dist/special-folders/index.js",
      "default": "./dist/special-folders/index.mjs"
    },
    "./provenance": {
      "types": "./dist/provenance/index.d.ts",
      "import": "./dist/provenance/index.mjs",
      "require": "./dist/provenance/index.js",
      "default": "./dist/provenance/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rslib build",
    "test": "vitest run",
    "dev": "vitest",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-config-auditor": "^2.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.5",
      "vitest": ">=3.2.6",
      "rollup": ">=4.59.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0",
      "brace-expansion": ">=2.0.2",
      "tmp": ">=0.2.6",
      "esbuild": ">=0.25.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.9.0"
}
